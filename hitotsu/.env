# サイト名はここ1か所で決める(画面・タイトル・規約ページすべてに反映される)
# ※サーバー側(支払いページの商品名)は server/api/config.php の site_name
VITE_SITE_NAME=ひとつ
VITE_SITE_NAME_LATIN=hitotsu
VITE_SITE_URL=https://hitotsu.gift

# Cloudflare Turnstile(ロボットよけ)のサイトキー。Cloudflare で発行して入れる。空なら確認を出さない
# ※シークレットキーのほうは server/api/config.php の turnstile_secret_key に入れる(ここには書かない)
VITE_TURNSTILE_SITE_KEY=
